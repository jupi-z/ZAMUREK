# ZAMUREK — EXEMPLE LOCAL NON OPÉRATIONNEL. Ne jamais committer de secrets réels.
NODE_ENV=development
API_PORT=3000
# Secrets injectés depuis un gestionnaire sécurisé, URL exclusivement locale de test.
PLATFORM_DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@127.0.0.1:5432/zamurek_registry
TENANT_DATABASE_ADMIN_SECRET_REF=CHANGE_ME
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_BUCKET_PREFIX=zamurek-dev
# Identité e-mail sans SMS : mode fake/mail capture en développement seulement.
EMAIL_TRANSPORT_MODE=local_capture
# Runtime agentique désactivé tant qu'aucun provider, budget et policy ne sont configurés.
AGENTIC_MODEL_PROVIDER=disabled
# Ne jamais utiliser ce fichier comme configuration de production.
# Ne jamais intégrer les credentials, tokens ou clés modèles dans React, APK, EXE/MSI.
